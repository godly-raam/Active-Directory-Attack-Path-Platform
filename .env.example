# ==========================================================================
# Local-only secrets for the attack box (Kali). Copy to .env and chmod 600.
# .env is git-ignored - never commit real values.
# ==========================================================================

# --- Azure authentication (preferred: `az login`, not a client secret) ----
# Only needed if you use a service principal instead of interactive login.
# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# --- Range admin credentials ---------------------------------------------
# Leave blank to let Terraform generate a random password and store it in
# Azure Key Vault. If you set these, they are written to terraform.tfvars,
# which is also git-ignored.
RANGE_ADMIN_USER=rangeadmin
# RANGE_ADMIN_PASSWORD=

# --- Attack-path engine: LLM provider ------------------------------------
# The engine reads its own PROJECT-scoped variables. It does NOT read, and
# must never read, the agent platform's MCAI_LLM_* variables.
AP_ENGINE_LLM_PROVIDER=anthropic
USER_LLM_API_KEY=sk-ant-REPLACE_ME
USER_LLM_BASE_URL=https://api.anthropic.com
USER_LLM_MODEL=claude-sonnet-4-5

# Optional: run without an LLM (deterministic scoring only)
AP_ENGINE_OFFLINE=0
