# ==========================================================================
# Attack-path engine configuration.
#
# Copy to .env (git-ignored) and edit. These variables are PROJECT-scoped and
# deliberately named USER_LLM_* so they never collide with the coding agent's
# own runtime credentials.
# ==========================================================================

# Provider: anthropic (default). Used only for ranking/explanation.
AP_ENGINE_LLM_PROVIDER=anthropic

# Your own API key. The engine does not read any platform/agent keys.
USER_LLM_API_KEY=sk-ant-REPLACE_ME
USER_LLM_BASE_URL=https://api.anthropic.com
USER_LLM_MODEL=claude-sonnet-4-5

# Set to 1 to skip the LLM entirely and use deterministic scoring only.
AP_ENGINE_OFFLINE=0

# Maximum number of paths sent to the LLM (cost control).
AP_ENGINE_TOP_N=15
